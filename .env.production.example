# Copy to .env.production on the production server. Never commit the real file.
SEHATLINE_DOMAIN=example.com

# Use long random values. Do not reuse the admin password here.
ADMIN_JWT_SECRET=replace-with-at-least-48-random-characters
MONGO_ROOT_USERNAME=sehatline
MONGO_ROOT_PASSWORD=replace-with-a-long-random-database-password

# MSG91 real OTP credentials.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
SEHATLINE_OTP_SANDBOX=false

# Razorpay Live Mode keys. Never expose the Key Secret in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Keep disabled until an authorised UIDAI/face provider is contracted and connected.
SEHATLINE_IDENTITY_SANDBOX=false

# Copy this file to .env.local. Never commit .env.local.
MONGODB_URI=
# Local-only fallback when MongoDB is intentionally unavailable.
SEHATLINE_SKIP_DATABASE=false

# Production web server binding. Keep 127.0.0.1 for local development.
HOST=127.0.0.1
PORT=4000
SEHATLINE_UPLOAD_ROOT=

# Google Maps Platform server key. Enable Places API (New) and Geocoding API.
# Restrict this key by server IP and to only those two APIs.
GOOGLE_MAPS_SERVER_API_KEY=

# Google Identity Services Web client ID. Add localhost and your live domain as
# authorised JavaScript origins in Google Cloud Console.
GOOGLE_IDENTITY_CLIENT_ID=

# Required in production. Use at least 32 random characters and keep it private.
ADMIN_JWT_SECRET=

MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# Optional legacy SendOTP configuration used by the doctor app.
MSG91_TEMPLATE_ID=

# Keep false for real SMS delivery. Enable only for explicit local testing.
SEHATLINE_OTP_SANDBOX=false

# Razorpay Standard Checkout for the paid doctor onboarding flow.
# Keep Key Secret and Webhook Secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# UIDAI-authorised provider integration is still required for production.
SEHATLINE_IDENTITY_SANDBOX=false

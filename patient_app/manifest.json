    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Find a doctor",
      "short_name": "Doctors",
      "url": "./#/doctors"
    },
    {
      "name": "Ask Sehat AI",
